{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LarsvdBrandt/signed-or-passed/schema/spec.schema.json",
  "title": "Signed or Passed production spec v1",
  "type": "object",
  "required": ["version", "slug", "format", "verdict", "voice", "scenes", "metadata", "thumbnail"],
  "properties": {
    "version": {"const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,80}$"},
    "format": {"enum": ["long", "short"]},
    "verdict": {"enum": ["SIGNED", "PASSED"]},
    "theme": {
      "enum": ["signed-or-passed", "paper-cutout", "engraving", "blueprint", "chalkboard", "retro-comic", "synthwave", "pastel-kids", "documentary-dark"],
      "default": "signed-or-passed",
      "description": "visual theme (render/src/themes, docs/library/themes.md); Signed or Passed uses the default house style"
    },
    "voice": {
      "type": "object",
      "required": ["engine", "voice"],
      "properties": {
        "engine": {"const": "kokoro"},
        "voice": {"type": "string", "pattern": "^[ab][fm]_[a-z]+$"},
        "speed": {"type": "number", "minimum": 0.5, "maximum": 2.0, "default": 1.1, "description": "Kokoro speed; the factory default is 1.1 when omitted"}
      }
    },
    "music": {
      "type": "object",
      "properties": {"mood": {"type": "string"}}
    },
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "license", "attribution", "sourcePage"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "license": {"type": "string"},
          "attribution": {"type": "string"},
          "sourcePage": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["title", "description", "tags", "categoryId", "containsSyntheticMedia", "madeForKids"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "titleAlternatives": {"type": "array", "items": {"type": "string", "maxLength": 100}},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "categoryId": {"type": "string"},
        "containsSyntheticMedia": {"type": "boolean"},
        "madeForKids": {"const": false}
      }
    },
    "thumbnail": {
      "type": "object",
      "required": ["bigText", "headline", "verdict"],
      "properties": {
        "bigText": {"type": "string", "maxLength": 16},
        "headline": {"type": "string"},
        "verdict": {"enum": ["SIGNED", "PASSED"]},
        "illustration": {"type": "string"}
      }
    },
    "shorts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scenes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}}
        }
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "kind", "narration", "visual"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "kind": {"enum": ["title", "illustration", "evidence", "chart", "counter", "timeline", "map", "city", "versus", "growth", "split-flap", "document", "photo-wall", "quote", "question", "reveal", "verdict", "lesson"]},
        "narration": {"type": "string", "minLength": 1},
        "onScreenText": {"type": ["string", "null"]},
        "visual": {"type": "object"},
        "motion": {
          "description": "Camera move: none | push-in | pull-out | pan | pan-left | pan-right | parallax (illustration scenes: layers move by depth), or {type, strength 0-3}",
          "oneOf": [
            {"type": ["string", "null"]},
            {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["none", "push-in", "pull-out", "pan", "pan-left", "pan-right", "parallax"]}, "strength": {"type": "number", "minimum": 0, "maximum": 3}}}
          ]
        },
        "sfx": {"enum": ["pen", "stamp", "paper", "whoosh", null]},
        "minDurationSec": {"type": "number", "minimum": 0},
        "dateTag": {"type": ["string", "null"], "description": "optional: text of the date tag bottom-left (extension, IBM Plex Mono)"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "title"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vTitle"}}}},
        {"if": {"properties": {"kind": {"const": "illustration"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vIllustration"}}}},
        {"if": {"properties": {"kind": {"const": "evidence"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vEvidence"}}}},
        {"if": {"properties": {"kind": {"const": "chart"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vChart"}}}},
        {"if": {"properties": {"kind": {"const": "counter"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vCounter"}}}},
        {"if": {"properties": {"kind": {"const": "timeline"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vTimeline"}}}},
        {"if": {"properties": {"kind": {"const": "map"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vMap"}}}},
        {"if": {"properties": {"kind": {"const": "city"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vCity"}}}},
        {"if": {"properties": {"kind": {"const": "versus"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vVersus"}}}},
        {"if": {"properties": {"kind": {"const": "growth"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vGrowth"}}}},
        {"if": {"properties": {"kind": {"const": "split-flap"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vSplitFlap"}}}},
        {"if": {"properties": {"kind": {"const": "document"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vDocument"}}}},
        {"if": {"properties": {"kind": {"const": "photo-wall"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vPhotoWall"}}}},
        {"if": {"properties": {"kind": {"const": "quote"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vQuote"}}}},
        {"if": {"properties": {"kind": {"const": "question"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vQuestion"}}}},
        {"if": {"properties": {"kind": {"const": "reveal"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vText"}}}},
        {"if": {"properties": {"kind": {"const": "lesson"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vText"}}}},
        {"if": {"properties": {"kind": {"const": "verdict"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vVerdict"}}}}
      ]
    },
    "vTitle": {"type": "object", "required": ["title"], "properties": {"title": {"type": "string"}, "subtitle": {"type": "string"}}},
    "vText": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}}},
    "vVerdict": {"type": "object", "required": ["verdict"], "properties": {"verdict": {"enum": ["SIGNED", "PASSED"]}}},
    "vIllustration": {
      "type": "object",
      "required": ["layers"],
      "properties": {
        "background": {"type": "string", "description": "paper | board | ink | stamp | CityBackdrop | OfficeBackdrop | BoardroomBackdrop"},
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component"],
            "properties": {
              "component": {"enum": [
                "Desk", "Contract", "FountainPen", "Stamp", "DecisionChair", "Person", "NameCard", "Building", "Phone", "Newspaper", "Briefcase", "MoneyStack", "Clock", "Calendar", "Arrow", "Spotlight",
                "Factory", "StoreFront", "Warehouse", "Bank", "StockBoard", "CrumblingBuilding", "AssemblyLine",
                "Ship", "ContainerShip", "Train", "Truck", "Airplane", "Rocket",
                "Computer", "Laptop", "Smartphone", "FloppyDisk", "VHSTape", "DVD", "FilmCamera", "DigitalCamera", "OldTelephone",
                "Guitar", "VinylRecord", "Sneaker", "Basketball", "Microphone",
                "Handshake", "Gavel", "Lightbulb", "CoinRain", "MoneyBag", "PriceTag", "ShareCertificate", "FallingChart", "Crowd", "Queue", "Envelope", "Telegram", "FlipCalendar", "Hourglass", "Scales", "MagnifyingGlass", "LockKey", "Trophy", "SpinningNewspaper",
                "CityBackdrop", "OfficeBackdrop", "BoardroomBackdrop"
              ]},
              "props": {"type": "object", "description": "colour, label, pose (and component specific props, see README)"},
              "x": {"type": "number", "description": "centre, percent of frame width (0-100)"},
              "y": {"type": "number", "description": "centre, percent of frame height (0-100)"},
              "scale": {"type": "number", "exclusiveMinimum": 0},
              "enter": {"type": "string", "description": "pop | fade | slide-up | slide-down | slide-left | slide-right | drop | none"},
              "delaySec": {"type": "number", "minimum": 0},
              "depth": {"type": "number", "minimum": 0, "maximum": 1, "description": "parallax depth: 0 = far background, 1 = foreground (default by layer order)"}
            }
          }
        }
      }
    },
    "vEvidence": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}, "caption": {"type": "string"}}},
    "vChart": {
      "type": "object",
      "required": ["type", "series", "sourceId"],
      "properties": {
        "type": {"enum": ["bar", "line"], "description": "line = self-drawing line with a moving value label"},
        "series": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "value"], "properties": {"label": {"type": "string"}, "value": {"type": "number"}}}},
        "unit": {"type": "string"},
        "sourceId": {"type": "string"}
      }
    },
    "vCounter": {"type": "object", "required": ["from", "to", "sourceId"], "properties": {"from": {"type": "number"}, "to": {"type": "number"}, "unit": {"type": "string"}, "sourceId": {"type": "string"}, "style": {"enum": ["plain", "money"], "description": "money = banknotes pile up while the number runs"}, "label": {"type": "string"}}},
    "vTimeline": {"type": "object", "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["date", "label"], "properties": {"date": {"type": "string"}, "label": {"type": "string"}}}}}},
    "vMap": {
      "type": "object",
      "required": ["pins"],
      "description": "WorldZoom: starts on a rotating globe (globe: false skips it), zooms into focus (country) and optionally a city, then pulls out to show all pins when arrows exist.",
      "properties": {
        "region": {"type": "string", "description": "world | europe | north-america | united-states | south-america | asia | africa | oceania (used when there is no focus)"},
        "focus": {"type": "string", "description": "country to zoom into and highlight: ISO 3166-1 alpha-3 (e.g. NLD), numeric code or English Natural Earth name"},
        "focusLabel": {"type": "string", "description": "optional big label on the focus country"},
        "focusColour": {"type": "string", "description": "brand colour name or hex; default ink"},
        "zoomTo": {"enum": ["country", "city", "none"], "description": "default country (when focus is set)"},
        "city": {"type": "object", "required": ["lat", "lon"], "properties": {"name": {"type": "string"}, "lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}},
        "highlight": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["country"], "properties": {"country": {"type": "string"}, "colour": {"type": "string"}}}]}, "description": "extra countries filled in stamp orange (or colour)"},
        "globe": {"type": "boolean", "description": "default true: start on a rotating globe"},
        "pins": {"type": "array", "items": {"type": "object", "required": ["lat", "lon", "label"], "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}, "label": {"type": "string"}}}},
        "arrows": {"type": "array", "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": ["string", "integer"], "description": "pin label or pin index"}, "to": {"type": ["string", "integer"]}}}}
      }
    },
    "vCity": {
      "type": "object",
      "properties": {
        "era": {"enum": ["1900s", "1950s", "modern"]},
        "density": {"enum": ["low", "medium", "high"]},
        "label": {"type": "string"},
        "night": {"type": "boolean"}
      }
    },
    "side": {"type": "object", "properties": {"label": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}, "colour": {"type": "string"}, "component": {"type": "string"}, "props": {"type": "object"}}},
    "vVersus": {"type": "object", "required": ["left", "right"], "properties": {"left": {"$ref": "#/$defs/side"}, "right": {"$ref": "#/$defs/side"}, "unit": {"type": "string"}, "sourceId": {"type": "string"}}},
    "vGrowth": {"type": "object", "required": ["to"], "properties": {"from": {"type": "number"}, "to": {"type": "number"}, "unit": {"type": "string"}, "label": {"type": "string"}, "sourceId": {"type": "string"}}},
    "vSplitFlap": {"type": "object", "required": ["rows"], "properties": {"rows": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "maxLength": 18}}, "accentRow": {"type": "integer", "minimum": 0}, "sourceId": {"type": "string"}}},
    "vDocument": {"type": "object", "properties": {"title": {"type": "string"}, "lines": {"type": "array", "maxItems": 7, "items": {"type": "string"}}, "verdict": {"enum": ["SIGNED", "PASSED"]}, "party": {"type": "string"}, "signature": {"type": "string"}}},
    "vPhotoWall": {"type": "object", "required": ["cards"], "properties": {"cards": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "required": ["label"], "properties": {"label": {"type": "string"}, "component": {"type": "string"}, "props": {"type": "object"}, "dark": {"type": "boolean"}}}}, "links": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}}}},
    "vQuote": {"type": "object", "required": ["text", "speaker", "sourceId", "status"], "properties": {"text": {"type": "string"}, "speaker": {"type": "string"}, "sourceId": {"type": "string"}, "status": {"enum": ["verified", "disputed"]}}},
    "vQuestion": {"type": "object", "required": ["question"], "properties": {"question": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}, "holdSec": {"type": "number", "minimum": 0, "maximum": 10}}}
  }
}
