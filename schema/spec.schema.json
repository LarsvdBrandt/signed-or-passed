{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LarsvdBrandt/signed-or-passed/schema/spec.schema.json",
  "title": "Signed or Passed production spec v1",
  "type": "object",
  "required": ["version", "slug", "format", "verdict", "voice", "scenes", "metadata", "thumbnail"],
  "properties": {
    "version": {"const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,80}$"},
    "format": {"enum": ["long", "short"]},
    "verdict": {"enum": ["SIGNED", "PASSED"]},
    "theme": {
      "enum": ["signed-or-passed", "paper-cutout", "engraving", "blueprint", "chalkboard", "retro-comic", "synthwave", "pastel-kids", "documentary-dark"],
      "default": "signed-or-passed",
      "description": "visual theme (render/src/themes, docs/library/themes.md); Signed or Passed uses the default house style"
    },
    "look": {
      "description": "global effects for every scene (render/src/effects, docs/library/effects.md): a preset name, an array of effects, or {preset, effects}. Scene effects are merged over it. Omit for the clean house style.",
      "oneOf": [
        {"$ref": "#/$defs/lookId"},
        {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/effect"}},
        {"type": "object", "properties": {"preset": {"$ref": "#/$defs/lookId"}, "effects": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/effect"}}}},
        {"type": "null"}
      ]
    },
    "transition": {"$ref": "#/$defs/transition", "description": "default transition into every scene (render/src/transitions, docs/library/effects.md); omit for the house paper-slide"},
    "captions": {"type": "object", "description": "long-form captions (docs/library/retention.md); Shorts keep their word-by-word captions", "properties": {"long": {"enum": ["keywords", "full", "off"], "description": "keywords (default): numbers, amounts, years and **emphasis** as big kinetic text; full: word-by-word captions; off"}, "style": {"type": ["string", "null"], "description": "keywords: stamp | ink | board (default: stamp for emphasis, board for numbers); full: a captionStyle"}}, "additionalProperties": false},
    "autoBeats": {"type": "boolean", "description": "auto camera beats for scenes without beats (default true)"},
    "sfxDensity": {"enum": ["low", "mid", "high"], "description": "automatic beat sounds (whoosh on punch/whip, pop on kinetic/pop/emphasis, tick on counters), well under the voice; default mid (docs/library/retention.md)"},
    "captionStyle": {
      "enum": ["bold-pop", "karaoke-highlight", "boxed", "minimal", null],
      "description": "burned-in Shorts captions (render/src/typography/captions.tsx, docs/library/typography.md); omit for the theme's own caption style"
    },
    "voice": {
      "type": "object",
      "required": ["engine", "voice"],
      "description": "TTS voice (pipeline/tts.py, brand/voices.json, docs/library/voices.md)",
      "properties": {
        "engine": {"enum": ["kokoro", "piper"]},
        "voice": {"type": "string", "description": "kokoro: a Kokoro v1.0 voice id (bm_george, af_heart, ef_dora ...); piper: a voice id listed in brand/voices.json (nl_BE-rdh-medium ...)"},
        "speaker": {"type": "integer", "minimum": 0, "description": "piper multi-speaker voices only (nl_NL-mls-medium: 0-51)"},
        "speed": {"type": "number", "minimum": 0.5, "maximum": 2.0, "description": "speaking speed; default 1.15 for kokoro, 1.0 for piper"}
      },
      "allOf": [
        {"if": {"properties": {"engine": {"const": "kokoro"}}}, "then": {"properties": {"voice": {"pattern": "^[abefhip][fm]_[a-z]+$"}}}},
        {"if": {"properties": {"engine": {"const": "piper"}}}, "then": {"properties": {"voice": {"pattern": "^[a-z]{2}_[A-Z]{2}-[a-z0-9_]+-(x_low|low|medium|high)$"}}}}
      ]
    },
    "music": {
      "type": "object",
      "description": "music bed and stingers (pipeline/mix.py, pipeline/musicgen.py, docs/library/music.md)",
      "properties": {
        "mood": {"type": "string", "description": "tense | curious | triumphant | somber | playful | epic | mysterious | upbeat (aliases: suspense, neutral, hopeful, sad, dramatic, mystery ...)"},
        "era": {"type": "string", "description": "modern | baroque | jazz-age | fifties | eighties | future, or an alias (ancient, medieval, 1600s, victorian, 1920s, 1950s, 1980s, 2000s ...)"},
        "source": {"enum": ["auto", "generated", "library", "none"], "default": "auto", "description": "auto = a library track with that mood if one exists, else a generated CC0 bed"},
        "stingers": {"type": "boolean", "default": true, "description": "musical hits at question and verdict scenes"}
      }
    },
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "license", "attribution", "sourcePage"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "license": {"type": "string"},
          "attribution": {"type": "string"},
          "sourcePage": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["title", "description", "tags", "categoryId", "containsSyntheticMedia", "madeForKids"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "titleAlternatives": {"type": "array", "items": {"type": "string", "maxLength": 100}},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "categoryId": {"type": "string"},
        "containsSyntheticMedia": {"type": "boolean"},
        "madeForKids": {"const": false}
      }
    },
    "thumbnail": {
      "type": "object",
      "required": ["bigText", "headline", "verdict"],
      "properties": {
        "bigText": {"type": "string", "maxLength": 16},
        "headline": {"type": "string"},
        "verdict": {"enum": ["SIGNED", "PASSED"]},
        "illustration": {"type": "string"}
      }
    },
    "shorts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scenes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}}
        }
      }
    }
  },
  "$defs": {
    "sfxName": {"type": "string", "pattern": "^[a-z0-9_]+$", "description": "house sound (pen, stamp, paper, whoosh) or any pipeline/sfxlib.py name (docs/library/sound-usage.md); validate_spec.py checks the name"},
    "effectId": {"enum": [
      "film-grain", "old-film", "vignette", "light-leaks", "vhs", "glitch", "chromatic-aberration", "ink-bleed", "paper-texture", "camera-shake", "gate-weave", "depth-of-field", "zoom-blur",
      "confetti", "dust", "smoke", "rain", "snow", "embers", "sparkles", "money-rain", "paper-scraps"
    ]},
    "lookId": {"enum": ["clean", "archival", "newsreel", "documentary", "cinematic", "vhs", "glitchy", "print", "handmade", "dreamy", "winter", "rainy", "celebration", "smoky"]},
    "effect": {
      "oneOf": [
        {"$ref": "#/$defs/effectId"},
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {"$ref": "#/$defs/effectId"},
            "intensity": {"type": "number", "minimum": 0, "maximum": 3, "description": "default 1; 0 switches a look effect off for this scene"},
            "params": {"type": "object", "description": "per effect, see docs/library/effects.md"}
          }
        }
      ]
    },
    "transitionId": {"enum": [
      "paper-slide", "cut", "fade", "push", "page-curl", "whip-pan", "iris-in", "iris-out", "wipe-left", "wipe-right", "wipe-up", "wipe-down",
      "diagonal-wipe", "clock-wipe", "barn-door", "ink-splash", "stamp-cut", "film-burn", "glitch-cut", "zoom-through", "flash"
    ]},
    "transition": {
      "oneOf": [
        {"$ref": "#/$defs/transitionId"},
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {"$ref": "#/$defs/transitionId"},
            "durationSec": {"type": "number", "minimum": 0.03, "maximum": 2, "description": "default per transition (0.35-0.9 s)"},
            "params": {"type": "object", "description": "per transition, see docs/library/effects.md (from, cx, cy, colour, text, vertical, edge)"}
          }
        },
        {"type": "null"}
      ]
    },
    "lowerThird": {
      "type": "object",
      "required": ["title"],
      "description": "lower third overlay (render/src/typography/overlays.tsx, docs/library/typography.md)",
      "properties": {
        "style": {"enum": ["bar", "tab", "underline"], "default": "bar"},
        "title": {"type": "string", "minLength": 1, "maxLength": 60},
        "subtitle": {"type": "string", "maxLength": 80},
        "atSec": {"type": "number", "minimum": 0, "description": "start relative to the scene (default 0.5)"},
        "durationSec": {"type": "number", "exclusiveMinimum": 0, "description": "default 4.5 (cut at the scene end)"}
      }
    },
    "beat": {
      "type": "object",
      "required": ["at", "do"],
      "description": "a visual beat (docs/library/retention.md)",
      "properties": {
        "at": {"description": "seconds from the scene start, or a word/phrase of the narration (first occurrence)", "oneOf": [{"type": "number", "minimum": 0}, {"type": "string", "minLength": 1}]},
        "do": {"enum": ["punch-in", "punch-out", "shake", "flash", "kinetic", "pop", "swap", "counter", "whip"]},
        "scale": {"type": "number", "minimum": 0.1, "maximum": 3, "description": "punch-in zoom (default 1.15); pop: illustration scale (default 0.8)"},
        "intensity": {"type": "number", "minimum": 0, "maximum": 3, "description": "shake strength (default 1)"},
        "direction": {"enum": ["left", "right"], "description": "whip direction"},
        "colour": {"type": "string", "description": "flash / kinetic colour: brand colour name or hex"},
        "text": {"type": "string", "description": "kinetic: the text"},
        "position": {"enum": ["top", "center", "lower"], "description": "kinetic / counter position"},
        "durationSec": {"type": "number", "minimum": 0.2},
        "component": {"type": "string", "description": "pop: illustration component (render/src/illustrations)"},
        "props": {"type": "object"},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "enter": {"type": "string"},
        "kind": {"type": "string", "description": "swap: scene kind of the new visual layer (default: same kind)"},
        "visual": {"type": "object", "description": "swap: the new visual"},
        "onScreenText": {"type": ["string", "null"]},
        "from": {"type": "number"},
        "to": {"type": "number"},
        "prefix": {"type": "string"},
        "suffix": {"type": "string"},
        "decimals": {"type": "integer", "minimum": 0, "maximum": 3},
        "countSec": {"type": "number", "minimum": 0.2},
        "label": {"type": "string"},
        "sfx": {"oneOf": [{"$ref": "#/$defs/sfxName"}, {"type": "null"}], "description": "override the automatic beat sound (null = none)"}
      },
      "allOf": [
        {"if": {"properties": {"do": {"const": "kinetic"}}}, "then": {"required": ["text"]}},
        {"if": {"properties": {"do": {"const": "pop"}}}, "then": {"required": ["component"]}},
        {"if": {"properties": {"do": {"const": "swap"}}}, "then": {"required": ["visual"]}},
        {"if": {"properties": {"do": {"const": "counter"}}}, "then": {"required": ["to"]}}
      ]
    },
    "scene": {
      "type": "object",
      "required": ["id", "kind", "narration", "visual"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "kind": {"enum": ["title", "illustration", "template", "evidence", "chart", "counter", "infographic", "kinetic-text", "chapter", "timeline", "map", "city", "versus", "growth", "split-flap", "document", "photo-wall", "shot", "quote", "question", "reveal", "verdict", "lesson"]},
        "narration": {"type": "string", "minLength": 1, "description": "spoken text; '[pause 0.5]' inserts 0.5 s of silence ('[PAUSE]' = 0.5 s; not spoken, not captioned); '**word**' marks an emphasised word or phrase: spoken normally, shown as a big kinetic keyword timed to the word (docs/library/retention.md)"},
        "voiceSpeed": {"type": "number", "minimum": 0.5, "maximum": 2.0, "description": "overrides voice.speed for this scene"},
        "onScreenText": {"type": ["string", "null"]},
        "visual": {"type": "object"},
        "motion": {
          "description": "Camera move: none | push-in | pull-out | pan | pan-left | pan-right, or for illustration scenes the parallax rig (layers move by depth): parallax | parallax-right | parallax-left | parallax-up | parallax-down | parallax-dolly | parallax-orbit; or {type, strength 0-3}",
          "oneOf": [
            {"type": ["string", "null"]},
            {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["none", "push-in", "pull-out", "pan", "pan-left", "pan-right", "parallax", "parallax-right", "parallax-left", "parallax-up", "parallax-down", "parallax-dolly", "parallax-orbit"]}, "strength": {"type": "number", "minimum": 0, "maximum": 3}}}
          ]
        },
        "transition": {"$ref": "#/$defs/transition", "description": "transition INTO this scene (overrides spec.transition)"},
        "effects": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/effect"}, "description": "overlay effects on this scene (docs/library/effects.md), merged over spec.look"},
        "lowerThird": {"oneOf": [{"$ref": "#/$defs/lowerThird"}, {"type": "null"}]},
        "beats": {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/beat"}, "description": "visual beats; a scene without beats gets subtle auto camera beats every ~2.5 s (docs/library/retention.md)"},
        "autoBeats": {"type": "boolean", "description": "false = no auto camera beats for this scene"},
        "sfx": {"oneOf": [{"$ref": "#/$defs/sfxName"}, {"type": "null"}], "description": "one sound at the scene start (house sounds keep their animation offsets)"},
        "sfxCues": {
          "type": "array",
          "maxItems": 12,
          "description": "extra sounds at exact moments, atSec relative to the scene start",
          "items": {
            "type": "object",
            "required": ["sfx", "atSec"],
            "properties": {
              "sfx": {"$ref": "#/$defs/sfxName"},
              "atSec": {"type": "number", "minimum": 0},
              "gainDb": {"type": "number", "minimum": -30, "maximum": 12}
            }
          }
        },
        "minDurationSec": {"type": "number", "minimum": 0},
        "dateTag": {"type": ["string", "null"], "description": "optional: text of the date tag bottom-left (extension, IBM Plex Mono)"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "title"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vTitle"}}}},
        {"if": {"properties": {"kind": {"const": "illustration"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vIllustration"}}}},
        {"if": {"properties": {"kind": {"const": "template"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vTemplate"}}}},
        {"if": {"properties": {"kind": {"const": "evidence"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vEvidence"}}}},
        {"if": {"properties": {"kind": {"const": "chart"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vChart"}}}},
        {"if": {"properties": {"kind": {"const": "counter"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vCounter"}}}},
        {"if": {"properties": {"kind": {"const": "infographic"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vInfographic"}}}},
        {"if": {"properties": {"kind": {"const": "kinetic-text"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vKineticText"}}}},
        {"if": {"properties": {"kind": {"const": "chapter"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vChapter"}}}},
        {"if": {"properties": {"kind": {"const": "timeline"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vTimeline"}}}},
        {"if": {"properties": {"kind": {"const": "map"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vMap"}}}},
        {"if": {"properties": {"kind": {"const": "city"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vCity"}}}},
        {"if": {"properties": {"kind": {"const": "versus"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vVersus"}}}},
        {"if": {"properties": {"kind": {"const": "growth"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vGrowth"}}}},
        {"if": {"properties": {"kind": {"const": "split-flap"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vSplitFlap"}}}},
        {"if": {"properties": {"kind": {"const": "document"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vDocument"}}}},
        {"if": {"properties": {"kind": {"const": "photo-wall"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vPhotoWall"}}}},
        {"if": {"properties": {"kind": {"const": "shot"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vShot"}}}},
        {"if": {"properties": {"kind": {"const": "quote"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vQuote"}}}},
        {"if": {"properties": {"kind": {"const": "question"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vQuestion"}}}},
        {"if": {"properties": {"kind": {"const": "reveal"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vText"}}}},
        {"if": {"properties": {"kind": {"const": "lesson"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vText"}}}},
        {"if": {"properties": {"kind": {"const": "verdict"}}}, "then": {"properties": {"visual": {"$ref": "#/$defs/vVerdict"}}}}
      ]
    },
    "vTitle": {"type": "object", "required": ["title"], "properties": {"title": {"type": "string"}, "subtitle": {"type": "string"}}},
    "vText": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}}},
    "vVerdict": {"type": "object", "required": ["verdict"], "properties": {"verdict": {"enum": ["SIGNED", "PASSED"]}}},
    "vTemplate": {
      "type": "object",
      "required": ["template"],
      "description": "ready-made era-aware scene (render/src/templates, docs/library/templates.md). Slots per template (labels / colours): boardroom-meeting left, right, chair, document, banner; phone-call-split-screen left, right, line; signing-ceremony left, right, document, stamp, banner; rejection-letter document, stamp, recipient, note; factory-floor company, boss, workers; stock-market-crash headline, index; store-opening-queue store, sign, note; garage-startup name, left, right, roof; press-conference speaker, org, podium, banner; courtroom court, left, right, case; ship-departure ship, destination, sea; city-at-night-thinking thought, person, windows. An empty label switches that name card / overlay off.",
      "properties": {
        "template": {"enum": ["boardroom-meeting", "phone-call-split-screen", "signing-ceremony", "rejection-letter", "factory-floor", "stock-market-crash", "store-opening-queue", "garage-startup", "press-conference", "courtroom", "ship-departure", "city-at-night-thinking"]},
        "era": {"type": "string", "description": "ancient | medieval | golden-age | industrial | twenties | fifties | eighties | nineties | noughties | modern | future, or an alias (rome, 1600s, victorian, 1920s, 1950s, 1980s, 1990s, 2000s, today ...); default per template"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "colours": {"type": "object", "additionalProperties": {"type": "string"}, "description": "brand colour names (ink, stamp, board, grey, greyLight, paper) or hex"},
        "props": {
          "type": "object",
          "description": "extensions: background (replaces the background), layers (extra illustration layers, also the template parts Garage, Podium, Bench, Quay, Waves, NightSkyline, WindowFrame; optional drift {dx, dy, startSec} in % per second), overlays [{text, x, y, style: stamp | sign | banner | caption | neon | flash, colour, rotate, delaySec, size}]",
          "properties": {
            "background": {"type": "string"},
            "layers": {"type": "array", "items": {"type": "object", "required": ["component"]}},
            "overlays": {"type": "array", "items": {"type": "object", "properties": {"text": {"type": "string"}, "x": {"type": "number"}, "y": {"type": "number"}, "style": {"enum": ["stamp", "sign", "banner", "caption", "neon", "flash"]}, "colour": {"type": "string"}, "rotate": {"type": "number"}, "delaySec": {"type": "number", "minimum": 0}, "size": {"type": "number", "exclusiveMinimum": 0}}}}
          }
        }
      }
    },
    "textPreset": {"enum": ["typewriter", "word-pop", "highlighter-marker", "strike-then-correct", "stamp-text", "neon-flicker", "handwritten-reveal", "newspaper-spin", "split-flap", "scrolling-ticker", "quote-card"]},
    "vKineticText": {
      "type": "object",
      "required": ["preset"],
      "description": "kinetic typography (render/src/typography, docs/library/typography.md)",
      "properties": {
        "preset": {"$ref": "#/$defs/textPreset"},
        "text": {"type": "string", "description": "use \\n for line breaks"},
        "lines": {"type": "array", "maxItems": 6, "items": {"type": "string"}},
        "accent": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}], "description": "words in the accent colour (word-pop) or under the marker (highlighter-marker)"},
        "background": {"enum": ["paper", "board", "ink", "stamp", "greyLight"]},
        "colour": {"type": "string", "description": "brand colour name or hex"},
        "accentColour": {"type": "string"},
        "wrong": {"type": "string", "description": "strike-then-correct"},
        "right": {"type": "string", "description": "strike-then-correct"},
        "cps": {"type": "number", "exclusiveMinimum": 0, "description": "typewriter characters per second (18)"},
        "stagger": {"type": "number", "exclusiveMinimum": 0, "description": "word-pop seconds between words"},
        "rotate": {"type": "number", "description": "stamp-text rotation in degrees (-8)"},
        "masthead": {"type": "string"},
        "date": {"type": "string"},
        "accentRow": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "description": "scrolling-ticker label (LATEST)"},
        "title": {"type": "string", "description": "scrolling-ticker title above the band"},
        "position": {"enum": ["centre", "bottom"]},
        "speed": {"type": "number", "exclusiveMinimum": 0},
        "speaker": {"type": "string"},
        "status": {"enum": ["verified", "disputed"]},
        "sourceId": {"type": "string"}
      }
    },
    "vChapter": {"type": "object", "required": ["title"], "properties": {"number": {"type": ["integer", "string"]}, "title": {"type": "string", "minLength": 1}, "label": {"type": "string"}}},
    "vShot": {
      "type": "object",
      "required": ["shot"],
      "description": "mood shot from render/src/moods (docs/library/moods.md): a short animated beat that sets an emotion",
      "properties": {
        "shot": {"enum": [
          "CartoonBonk", "SweatDrop", "QuestionMarks", "DotsBubble", "BananaSlip", "RecordScratch", "ExaggeratedZoom", "Tumbleweed", "Crickets",
          "RainCloud", "WiltingPlant", "ClosedSign", "LightsOut", "EmptyOffice", "FallingLeaf",
          "TickingClockCloseUp", "HeartbeatLine", "InterrogationSpotlight", "SlowPushIn", "RedAlert",
          "Confetti", "Fireworks", "RisingRocket", "TrophyShine", "CheeringCrowd",
          "Fog", "SilhouetteReveal", "MagnifierSweep"
        ]},
        "props": {"type": "object", "description": "per shot (see docs/library/moods.md): text, colour, caption; CartoonBonk object anvil | book; DotsBubble revealSec; ClosedSign front, shop; TickingClockCloseUp startSec; HeartbeatLine bpmFrom, bpmTo; SlowPushIn figureColour; RedAlert sub; RisingRocket value; MagnifierSweep title"},
        "label": {"type": "string", "description": "optional small caption at the top (IBM Plex Mono)"}
      }
    },
    "vIllustration": {
      "type": "object",
      "required": ["layers"],
      "properties": {
        "background": {"type": "string", "description": "paper | board | ink | stamp | CityBackdrop | OfficeBackdrop | BoardroomBackdrop | an era backdrop (AncientBackdrop, MedievalBackdrop, GoldenAgeBackdrop, IndustrialBackdrop, DecoBackdrop, DinerBackdrop, NeonBackdrop, CubicleBackdrop, OpenPlanBackdrop, FutureSkylineBackdrop; docs/library/eras.md)"},
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component"],
            "properties": {
              "component": {"enum": [
                "Desk", "Contract", "FountainPen", "Stamp", "DecisionChair", "Person", "Character", "Crowd2", "NameCard", "Building", "Phone", "Newspaper", "Briefcase", "MoneyStack", "Clock", "Calendar", "Arrow", "Spotlight",
                "Factory", "StoreFront", "Warehouse", "Bank", "StockBoard", "CrumblingBuilding", "AssemblyLine",
                "Ship", "ContainerShip", "Train", "Truck", "Airplane", "Rocket",
                "Computer", "Laptop", "Smartphone", "FloppyDisk", "VHSTape", "DVD", "FilmCamera", "DigitalCamera", "OldTelephone",
                "Guitar", "VinylRecord", "Sneaker", "Basketball", "Microphone",
                "Handshake", "Gavel", "Lightbulb", "CoinRain", "MoneyBag", "PriceTag", "ShareCertificate", "FallingChart", "Crowd", "Queue", "Envelope", "Telegram", "FlipCalendar", "Hourglass", "Scales", "MagnifyingGlass", "LockKey", "Trophy", "SpinningNewspaper",
                "CityBackdrop", "OfficeBackdrop", "BoardroomBackdrop",
                "AncientBackdrop", "ColumnTemple", "Pyramid", "Amphora", "Scroll", "Laurel", "OilLamp", "AncientCoin", "WaxTablet", "Galley", "Chariot",
                "MedievalBackdrop", "CastleGate", "MarketStall", "QuillParchment", "WaxSeal", "SwordShield", "Cart", "Lantern", "GuildSign",
                "GoldenAgeBackdrop", "Fluyt", "CanalHouse", "Tulip", "SpiceSacks", "Globe", "Compass", "Ledger",
                "IndustrialBackdrop", "SteamEngine", "TelegraphKey", "TopHat", "PocketWatch", "GasLamp", "FactoryGate", "PennyFarthing",
                "DecoBackdrop", "TickerTape", "Gramophone", "VintageCar", "Breadline", "CathedralRadio", "CocktailGlass", "NewsboyCap",
                "DinerBackdrop", "Jukebox", "TVSet", "FinCar", "RotaryPhone", "Typewriter", "RocketToy", "Milkshake",
                "NeonBackdrop", "ArcadeCabinet", "Cassette", "CRTTV", "Boombox", "Calculator", "Mainframe", "PersonalStereo",
                "CubicleBackdrop", "BeigePC", "DialUpModem", "CDROM", "Pager", "EarlyWebsite", "ServerRack", "ComputerMouse",
                "OpenPlanBackdrop", "FlipPhone", "MP3Player", "FlatScreen", "LaptopBag", "WifiRouter", "USBStick", "CompactCamera",
                "FutureSkylineBackdrop", "SmartphoneGrid", "Drone", "EV", "DataCentre", "VRHeadset", "RobotArm", "SolarPanel"
              ]},
              "props": {"type": "object", "description": "colour, label, pose (and component specific props, see README and docs/library/characters.md). Character: pose stand | walk | run | sit | type | point | shrug | facepalm | celebrate | slump | arms-crossed | handshake | applause | thinking | shock | wave | talk | phone | protest; costume plain | suit | toga | tunic | merchant | victorian | twenties | fifties | dress | eighties | casual | hoodie | future | worker | labcoat | royal | trenchcoat, or an era alias (ancient, medieval, 1600s, victorian, 1920s, 1950s, 1980s, 2000s, modern, future ...); era (alias used when costume is not set); hat top-hat | bowler | fedora | boater | flat-cap | baseball-cap | hard-hat | crown | laurel | capotain | medieval-cap | beret | cowboy | headphones | none (default from the costume); hold / holdLeft briefcase | phone | smartphone | newspaper | coffee | moneybag | pen | contract | placard; holdText (placard text); flip, speed (1 = normal), phase (seconds), blendSec. Crowd2 (1200x520): count 1-24, seed, costumes (ids or era aliases, array or comma separated), era, colours, poses, animate (default true), rows 1-3, label"},
              "x": {"type": "number", "description": "centre, percent of frame width (0-100)"},
              "y": {"type": "number", "description": "centre, percent of frame height (0-100)"},
              "scale": {"type": "number", "exclusiveMinimum": 0},
              "enter": {"type": "string", "description": "pop | fade | slide-up | slide-down | slide-left | slide-right | drop | none"},
              "delaySec": {"type": "number", "minimum": 0},
              "depth": {"type": "number", "minimum": 0, "maximum": 1, "description": "parallax depth: 0 = far background, 1 = foreground (default by layer order)"}
            }
          }
        }
      }
    },
    "vEvidence": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}, "caption": {"type": "string"}}},
    "vChart": {
      "type": "object",
      "required": ["type", "series", "sourceId"],
      "properties": {
        "type": {"enum": ["bar", "line"], "description": "line = self-drawing line with a moving value label"},
        "series": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["label", "value"], "properties": {"label": {"type": "string"}, "value": {"type": "number"}}}},
        "unit": {"type": "string"},
        "sourceId": {"type": "string"}
      }
    },
    "vCounter": {"type": "object", "required": ["from", "to", "sourceId"], "properties": {"from": {"type": "number"}, "to": {"type": "number"}, "unit": {"type": "string"}, "sourceId": {"type": "string"}, "style": {"enum": ["plain", "money"], "description": "money = banknotes pile up while the number runs"}, "label": {"type": "string"}}},
    "infographicType": {"enum": ["bar-race", "line-annotated", "pie", "donut", "stacked-area", "ranking", "ticker", "percent-ring", "bubble", "comparison-table", "calendar-heatmap", "map-choropleth", "money-stacks", "what-could-buy", "org-chart", "family-tree", "flow"]},
    "vInfographic": {
      "type": "object",
      "required": ["type", "data"],
      "description": "animated infographic from render/src/infographics (docs/library/infographics.md). Data types need a sourceId (validate_spec.py); the diagrams org-chart, family-tree and flow do not. data per type: bar-race {periods[], series[{label, values[], colour?}], top?}; line-annotated {points[{label, value}], annotations?[{at: index|label, text}]}; pie / donut {slices[{label, value, colour?}], highlight?, centerText?, centerLabel?, showValues?}; stacked-area {labels[], series[{label, values[], colour?}]}; ranking {items[{label, value?, note?}], order?: top-down|countdown}; ticker {from, to, decimals?, label?}; percent-ring {rings[{label, value 0-100, colour?}]} or {value, label}; bubble {bubbles[{label, value, colour?}]}; comparison-table {columns[], rows[{label, values[number|string|true|false|null]}], highlight?}; calendar-heatmap {start: YYYY-MM-DD, values[]} or {days[{date, value}]}, colour?, showTotal?; map-choropleth {values[{country: ISO3|name, value}], region?, bins?, colour?, legend?, showValues?}; money-stacks {items[{label, value, colour?}]}; what-could-buy {amount, price, item, icon?: box|house|car|person|coin|bag, max?, colour?}; org-chart {root: {label, title?, highlight?, colour?, children[]}} or {nodes[{id, label, title?, parent?}]}; family-tree {root: {label, years?, partner?: {label, years?} | name, highlight?, children[]}} or {nodes[{id, label, years?, parent?, partner?}]}; flow {steps[{id?, label, note?, shape?: box|decision|start|end, colour?, highlight?}], links?[{from, to, label?}], direction?: horizontal|vertical, numbered?}",
      "properties": {
        "type": {"$ref": "#/$defs/infographicType"},
        "title": {"type": "string", "description": "kicker top-left (default scene.onScreenText)"},
        "unit": {"type": "string", "description": "$, EUR sign, %, or a word (suffix)"},
        "sourceId": {"type": "string"},
        "data": {"type": "object"}
      }
    },
    "vTimeline": {"type": "object", "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["date", "label"], "properties": {"date": {"type": "string"}, "label": {"type": "string"}}}}}},
    "vMap": {
      "type": "object",
      "required": ["pins"],
      "description": "WorldZoom: starts on a rotating globe (globe: false skips it), zooms into focus (country) and optionally a city, then pulls out to show all pins when arrows exist.",
      "properties": {
        "region": {"type": "string", "description": "world | europe | north-america | united-states | south-america | asia | africa | oceania (used when there is no focus)"},
        "focus": {"type": "string", "description": "country to zoom into and highlight: ISO 3166-1 alpha-3 (e.g. NLD), numeric code or English Natural Earth name"},
        "focusLabel": {"type": "string", "description": "optional big label on the focus country"},
        "focusColour": {"type": "string", "description": "brand colour name or hex; default ink"},
        "zoomTo": {"enum": ["country", "city", "none"], "description": "default country (when focus is set)"},
        "city": {"type": "object", "required": ["lat", "lon"], "properties": {"name": {"type": "string"}, "lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}},
        "highlight": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object", "required": ["country"], "properties": {"country": {"type": "string"}, "colour": {"type": "string"}}}]}, "description": "extra countries filled in stamp orange (or colour)"},
        "globe": {"type": "boolean", "description": "default true: start on a rotating globe"},
        "pins": {"type": "array", "items": {"type": "object", "required": ["lat", "lon", "label"], "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}, "label": {"type": "string"}}}},
        "arrows": {"type": "array", "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": ["string", "integer"], "description": "pin label or pin index"}, "to": {"type": ["string", "integer"]}}}}
      }
    },
    "vCity": {
      "type": "object",
      "properties": {
        "era": {"enum": ["1900s", "1950s", "modern"]},
        "density": {"enum": ["low", "medium", "high"]},
        "label": {"type": "string"},
        "night": {"type": "boolean"}
      }
    },
    "side": {"type": "object", "properties": {"label": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}, "colour": {"type": "string"}, "component": {"type": "string"}, "props": {"type": "object"}}},
    "vVersus": {"type": "object", "required": ["left", "right"], "properties": {"left": {"$ref": "#/$defs/side"}, "right": {"$ref": "#/$defs/side"}, "unit": {"type": "string"}, "sourceId": {"type": "string"}}},
    "vGrowth": {"type": "object", "required": ["to"], "properties": {"from": {"type": "number"}, "to": {"type": "number"}, "unit": {"type": "string"}, "label": {"type": "string"}, "sourceId": {"type": "string"}}},
    "vSplitFlap": {"type": "object", "required": ["rows"], "properties": {"rows": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "maxLength": 18}}, "accentRow": {"type": "integer", "minimum": 0}, "sourceId": {"type": "string"}}},
    "vDocument": {"type": "object", "properties": {"title": {"type": "string"}, "lines": {"type": "array", "maxItems": 7, "items": {"type": "string"}}, "verdict": {"enum": ["SIGNED", "PASSED"]}, "party": {"type": "string"}, "signature": {"type": "string"}}},
    "vPhotoWall": {"type": "object", "required": ["cards"], "properties": {"cards": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "required": ["label"], "properties": {"label": {"type": "string"}, "component": {"type": "string"}, "props": {"type": "object"}, "dark": {"type": "boolean"}}}}, "links": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}}}},
    "vQuote": {"type": "object", "required": ["text", "speaker", "sourceId", "status"], "properties": {"text": {"type": "string"}, "speaker": {"type": "string"}, "sourceId": {"type": "string"}, "status": {"enum": ["verified", "disputed"]}}},
    "vQuestion": {"type": "object", "required": ["question"], "properties": {"question": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}, "holdSec": {"type": "number", "minimum": 0, "maximum": 10}}}
  }
}
